rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'preferredLanguage', 'createdAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'preferredLanguage', 'location', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.preferredLanguage in ['en', 'as', 'bn', 'brx']
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('location' in data) || (data.location is string && data.location.size() <= 100));
    }

    function isValidCropLog(data) {
      return data.keys().hasAll(['id', 'userId', 'crop', 'disease', 'pathogen', 'confidence', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'crop', 'disease', 'pathogen', 'confidence', 'status', 'imageUrl', 'createdAt', 'healthy'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.crop is string && data.crop.size() > 0 && data.crop.size() <= 80
        && data.disease is string && data.disease.size() > 0 && data.disease.size() <= 120
        && data.pathogen is string && data.pathogen.size() <= 50
        && data.confidence is number && data.confidence >= 0 && data.confidence <= 100
        && data.status in ['Under Treatment', 'Crop Improved', 'Worsened']
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('healthy' in data) || data.healthy is bool)
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'role', 'text', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'role', 'text', 'source', 'timestamp', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.role in ['user', 'assistant']
        && data.text is string && data.text.size() > 0 && data.text.size() <= 10000
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('source' in data) || (data.source is string && data.source.size() <= 50))
        && (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 50));
    }

    // User profile document rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // Crop Health Log collection rules
      match /cropLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidCropLog(incoming());
        allow update: if isOwner(userId) && isValidId(logId) && isValidCropLog(incoming())
          && incoming().userId == existing().userId
          && incoming().id == existing().id
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'imageUrl']);
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Chat Messages collection rules
      match /chatMessages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming());
        allow delete: if isOwner(userId) && isValidId(messageId);
      }
    }
  }
}
